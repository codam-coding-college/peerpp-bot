# https://api.slack.com/apps/A03MQA4T4BE/install-on-team?
SLACK_TOKEN = ""

# Activate socket mode for the bot on
# https://app.slack.com/app-settings/T03652S1FFU/A03MQA4T4BE/socket-mode
# replace the T03652S1FFU (Slack workspace ID) with your own
# https://api.slack.com/apps/A03MQA4T4BE
# app token is listed on the above page, under "App-Level Tokens"
SLACK_APP_TOKEN = ""

# Webhook Secret for the Intra API (X-Secret header)
# The uri should be: https://example.com/webhook
# https://admin.intra.42.fr/webhook_registeries/902/edit
# https://admin.intra.42.fr/webhook_registeries/1060/edit
# https://admin.intra.42.fr/webhook_registeries/1061/edit
WEBHOOK_CREATE_SECRET = ""
WEBHOOK_DELETE_SECRET = ""
WEBHOOK_UPDATE_SECRET = ""

# Intra application keys
# https://profile.intra.42.fr/oauth/applications/8540
INTRA_UID = ""
INTRA_SECRET = ""

# Optional, the bot runs without it
SENTRY_SECRET = ""

# Optional, this is the default
WEBHOOK_PORT = 8080
